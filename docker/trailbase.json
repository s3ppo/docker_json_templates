{
  "name": "TrailBase",
  "repo": "trailbase/trailbase",
  "category": [ "network" ],    
  "network": "bridge",
  "custom_ip": "",
  "default_shell": "",
  "privileged": false,
  "no_autoupdate": false,
  "extra_parameters": "",
  "post_parameters": "",
  "description": "An open, sub-millisecond, single-executable Firebase alternative with type-safe REST & realtime APIs, multi-DB, WebAssembly runtime, geospatial support, SSR, auth and admin UI built on Rust, Wasmtime & SQLite (or now experimentally Postgres).",
  "support": "https://github.com/trailbaseio/trailbase/issues",
  "web_ui_url": "http://[IP]:[PORT:4000]",
  "icon": "https://raw.githubusercontent.com/trailbaseio/trailbase/main/assets/logo.svg",
  "paths": [
    {
      "name": "Traildepot",
      "mode": "rw",
      "host": "/mnt/cache/appdata/trailbase/traildepot",
      "container": "/app/traildepot",
      "description": ""
    }
  ],
  "ports": [
    {
      "name": "WebUI Port",
      "protocol": "tcp",
      "host": "4000",
      "container": "4000",
      "description": ""
    }
  ],
  "variables": [],
  "devices": [],
  "labels": [],
  "gpus": []
}