{
  "name": "Glance",
  "repo": "glanceapp/glance",
  "registry": "https://hub.docker.com/r/glanceapp/glance",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "icon": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/glance.png",
  "project": "https://github.com/glanceapp/glance",
  "support": "https://forums.unraid.net/topic/167893-support-devzwf-glance/",
  "description": "What if you could see everything at a...\r\n\r\nGlance\r\n\r\nContainer expect a &quot;glance.yml&quot; file to be mounted at /app/glance.yml before running. See https://github.com/glanceapp/glance/blob/main/docs/configuration.md for more information.",
  "paths": [
    {
      "name": "Localtime",
      "host": "/etc/localtime",
      "container": "/etc/localtime",
      "mode": "ro",
      "description": null,
      "required": true
    },
    {
      "name": "Config Directory",
      "host": "/mnt/cache/appdata/glance/config",
      "container": "/app/config/",
      "mode": "rw",
      "description": "Configuration Directory",
      "required": true
    },
    {
      "name": "Assets Directory",
      "host": "/mnt/cache/appdata/glance/assets",
      "container": "/app/assets",
      "mode": "rw",
      "description": null,
      "required": true
    }
  ],
  "ports": [
    {
      "name": "Web UI port",
      "host": "8080",
      "container": "8080",
      "protocol": "tcp",
      "description": null,
      "required": true,
      "mask": false
    }
  ],
  "variables": [],
  "devices": [],
  "labels": []
}