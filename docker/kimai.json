{
  "name": "kimai",
  "repo": "kimai/kimai2:apache",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8001]",
  "icon": "https://raw.githubusercontent.com/kimai/kimai/refs/heads/main/public/touch-icon-180x180.png",
  "paths": [
    {
      "name": "Config",
      "mode": "rw",
      "host": "/mnt/cache/appdata/kimai/config/",
      "container": "/config"
    },
    {
      "name": "var",
      "mode": "rw",
      "host": "/mnt/cache/appdata/kimai/var/",
      "container": "/opt/kimai/var"
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "protocol": "tcp",
      "host": "8001",
      "container": "8001"
    }
  ],
  "variables": [
    {
      "name": "TRUSTED_HOSTS",
      "key": "TRUSTED_HOSTS",
      "value": "localhost|127.0.0.1",
      "mask": false
    },
    {
      "name": "ADMINMAIL",
      "key": "ADMINMAIL",
      "value": "your@email.com",
      "mask": false
    },
    {
      "name": "ADMINPASS",
      "key": "ADMINPASS",
      "value": "1234567890",
      "mask": true
    },
    {
      "name": "DATABASE_URL",
      "key": "DATABASE_URL",
      "value": "mysql://user:password!@localhost:3306/kimai",
      "mask": true
    }
  ],
  "devices": [],
  "gpus": []
}